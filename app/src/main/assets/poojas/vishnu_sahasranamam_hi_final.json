{
  "id": "vishnu_sahasranamam_hi",
  "name_en": "Vishnu Sahasranamam",
  "name_te": "విష్ణు సహస్రనామం",
  "name_hi": "विष्णु सहस्रनाम",
  "language": "hi",
  "category": "sahasranamam",
  "addedDate": "2025-07-24",
  "content": {
    "verses": [
      {
        "line": 1,
        "text": "शुक्लाम्बरधरं विष्णुं शशिवर्णं चतुर्भुजम् ।"
      },
      {
        "line": 2,
        "text": "प्रसन्नवदनं ध्यायेत् सर्वविघ्नोपशान्तये ॥१॥"
      },
      {
        "line": 3,
        "text": "यस्य द्विरदवक्त्राद्याः पारिषद्याः परः शतम् ‌।"
      },
      {
        "line": 4,
        "text": "विघ्नं निघ्नन्ति सततं विष्वक्सेनं तमाश्रये ॥२॥"
      },
      {
        "line": 5,
        "text": "व्यासं वसिष्ठनप्तारं शक्तेः पौत्रमकल्मषम् ‌।"
      },
      {
        "line": 6,
        "text": "पराशरात्मजं वन्दे शुकतातं तपोनिधिम् ॥३॥"
      },
      {
        "line": 7,
        "text": "व्यासाय विष्णुरूपाय व्यासरूपाय विष्णवे ।"
      },
      {
        "line": 8,
        "text": "नमो वै ब्रह्मनिधये वासिष्ठाय नमो नमः ॥४॥"
      },
      {
        "line": 9,
        "text": "अविकाराय शुद्धाय नित्याय परमात्मने ।"
      },
      {
        "line": 10,
        "text": "सदैकरूपरूपाय विष्णवे सर्वजिष्णवे ॥५॥"
      },
      {
        "line": 11,
        "text": "यस्य स्मरणमात्रेण जन्मसंसारबन्धनात् ।"
      },
      {
        "line": 12,
        "text": "विमुच्यते नमस्तस्मै विष्णवे प्रभविष्णवे ॥६॥"
      },
      {
        "line": 13,
        "text": "ॐ नमो विष्णवे प्रभविष्णवे।"
      },
      {
        "line": 14,
        "text": "श्रीवैशम्पायन उवाच-"
      },
      {
        "line": 15,
        "text": "श्रुत्वा धर्मानशेषेण पावनानि च सर्वशः ।"
      },
      {
        "line": 16,
        "text": "युधिष्ठिरः शान्तनवं पुनरेवाभ्यभाषत ॥७॥"
      },
      {
        "line": 17,
        "text": "युधिष्ठिर उवाच-"
      },
      {
        "line": 18,
        "text": "किमेकं दैवतं लोके किं वाप्येकं परायणम् ।"
      },
      {
        "line": 19,
        "text": "स्तुवन्तः कं कमर्चन्तः प्राप्नुयुर्मानवाः शुभम् ॥८॥"
      },
      {
        "line": 20,
        "text": "को धर्मः सर्वधर्माणां भवतः परमो मतः ।"
      },
      {
        "line": 21,
        "text": "किं जपन्मुच्यते जन्तुर्जन्मसंसारबन्धनात् ॥९॥"
      },
      {
        "line": 22,
        "text": "भीष्म उवाच-"
      },
      {
        "line": 23,
        "text": "जगत्प्रभुं देवदेवमनन्तं पुरुषोत्तमम् ।"
      },
      {
        "line": 24,
        "text": "स्तुवन् नामसहस्रेण पुरुषः सततोत्थितः ॥१०॥"
      },
      {
        "line": 25,
        "text": "तमेव चार्चयन्नित्यं भक्त्या पुरुषमव्ययम् ।"
      },
      {
        "line": 26,
        "text": "ध्यायन् स्तुवन् नमस्यंश्च यजमानस्तमेव च ॥११॥"
      },
      {
        "line": 27,
        "text": "अनादिनिधनं विष्णुं सर्वलोकमहेश्वरम् ।"
      },
      {
        "line": 28,
        "text": "लोकाध्यक्षं स्तुवन्नित्यं सर्वदुःखातिगो भवेत् ॥१२॥"
      },
      {
        "line": 29,
        "text": "ब्रह्मण्यं सर्वधर्मज्ञं लोकानां कीर्तिवर्धनम् ।"
      },
      {
        "line": 30,
        "text": "लोकनाथं महद्भूतं सर्वभूतभवोद्भवम् ॥१३॥"
      },
      {
        "line": 31,
        "text": "एष मे सर्वधर्माणां धर्मोऽधिकतमो मतः ।"
      },
      {
        "line": 32,
        "text": "यद्भक्त्या पुण्डरीकाक्षं स्तवैरर्चेन्नरः सदा ॥१४॥"
      },
      {
        "line": 33,
        "text": "परमं यो महत्तेजः परमं यो महत्तपः ।"
      },
      {
        "line": 34,
        "text": "परमं यो महद्ब्रह्म परमं यः परायणम् ॥१५॥"
      },
      {
        "line": 35,
        "text": "पवित्राणां पवित्रं यो मङ्गलानां च मङ्गलम् ।"
      },
      {
        "line": 36,
        "text": "दैवतं दैवतानां च भूतानां योऽव्ययः पिता ॥१६॥"
      },
      {
        "line": 37,
        "text": "यतः सर्वाणि भूतानि भवन्त्यादियुगागमे ।"
      },
      {
        "line": 38,
        "text": "यस्मिंश्च प्रलयं यान्ति पुनरेव युगक्षये ॥१७॥"
      },
      {
        "line": 39,
        "text": "तस्य लोकप्रधानस्य जगन्नाथस्य भूपते ।"
      },
      {
        "line": 40,
        "text": "विष्णोर्नामसहस्रं मे शृणु पापभयापहम् ॥१८॥"
      },
      {
        "line": 41,
        "text": "यानि नामानि गौणानि विख्यातानि महात्मनः ।"
      },
      {
        "line": 42,
        "text": "ऋषिभिः परिगीतानि तानि वक्ष्यामि भूतये ॥१९॥"
      },
      {
        "line": 43,
        "text": "ऋषिर्नाम्नां सहस्रस्य वेदव्यासो महामुनिः ।"
      },
      {
        "line": 44,
        "text": "छन्दोऽनुष्टुप् तथा देवो भगवान् देवकीसुतः ॥२०॥"
      },
      {
        "line": 45,
        "text": "अमृतांशूद्भवो बीजं शक्तिर्देवकिनन्दनः ।"
      },
      {
        "line": 46,
        "text": "त्रिसामा हृदयं तस्य शान्त्यर्थे विनियोज्यते ॥२१॥"
      },
      {
        "line": 47,
        "text": "विष्णुं जिष्णुं महाविष्णुं प्रभविष्णुं महेश्वरम् ‌।"
      },
      {
        "line": 48,
        "text": "अनेकरूप दैत्यान्तं नमामि पुरुषोत्तमं ॥२२॥"
      },
      {
        "line": 49,
        "text": "पूर्वन्यासः"
      },
      {
        "line": 50,
        "text": "श्रीवेदव्यास उवाच-"
      },
      {
        "line": 51,
        "text": "ॐ अस्य श्रीविष्णोर्दिव्यसहस्रनामस्तोत्रमहामन्त्रस्य ॥"
      },
      {
        "line": 52,
        "text": "श्री वेदव्यासो भगवान ऋषिः ।"
      },
      {
        "line": 53,
        "text": "अनुष्टुप् छन्दः ।"
      },
      {
        "line": 54,
        "text": "श्रीमहाविष्णुः परमात्मा श्रीमन्नारायणो देवता ।"
      },
      {
        "line": 55,
        "text": "अमृतांशूद्भवो भानुरिति बीजम्‌ ।"
      },
      {
        "line": 56,
        "text": "देवकीनन्दनः स्रष्टेति शक्तिः ।"
      },
      {
        "line": 57,
        "text": "उद्भवः क्षोभणो देव इति परमो मन्त्रः ।"
      },
      {
        "line": 58,
        "text": "शङ्खभृन्नन्दकी चक्रीति कीलकम् ।"
      },
      {
        "line": 59,
        "text": "शार्ङ्गधन्वा गदाधर इत्यस्त्रम् ।"
      },
      {
        "line": 60,
        "text": "रथाङ्गपाणिरक्षोभ्य इति नेत्रम् ‌।"
      },
      {
        "line": 61,
        "text": "त्रिसामा सामगः सामेति कवचम् ।"
      },
      {
        "line": 62,
        "text": "आनन्दं परब्रह्मेति योनिः ।"
      },
      {
        "line": 63,
        "text": "ऋतुः सुदर्शनः काल इति दिग्बन्धः ॥"
      },
      {
        "line": 64,
        "text": "श्रीविश्वरूप इति ध्यानम्‌ ।"
      },
      {
        "line": 65,
        "text": "श्रीमहाविष्णुप्रीत्यर्थं सहस्रनामजपे विनियोगः ॥"
      },
      {
        "line": 66,
        "text": "अथ न्यासः"
      },
      {
        "line": 67,
        "text": "ॐ शिरसि वेदव्यासऋषये नमः ।"
      },
      {
        "line": 68,
        "text": "मुखे अनुष्टुप्छन्दसे नमः ।"
      },
      {
        "line": 69,
        "text": "हृदि श्रीकृष्णपरमात्मदेवतायै नमः ।"
      },
      {
        "line": 70,
        "text": "गुह्ये अमृतांशूद्भवो भानुरिति बीजाय नमः ।"
      },
      {
        "line": 71,
        "text": "पादयोर्देवकीनन्दनः स्रष्टेति शक्तये नमः ।"
      },
      {
        "line": 72,
        "text": "सर्वाङ्गे शङ्खभृन्नन्दकी चक्रीति कीलकाय नमः ।"
      },
      {
        "line": 73,
        "text": "करसंपूटे मम श्रीकृष्णप्रीत्यर्थे जपे विनियोगाय नमः ॥"
      },
      {
        "line": 74,
        "text": "इति ऋषयादिन्यासः ॥"
      },
      {
        "line": 75,
        "text": "अथ करन्यासः"
      },
      {
        "line": 76,
        "text": "ॐ विश्वं विष्णुर्वषट्कार इत्यङ्गुष्ठाभ्यां नमः ।"
      },
      {
        "line": 77,
        "text": "अमृतांशूद्भवो भानुरिति तर्जनीभ्यां नमः ।"
      },
      {
        "line": 78,
        "text": "ब्रह्मण्यो ब्रह्मकृद्ब्रह्मेति मध्यमाभ्यां नमः ।"
      },
      {
        "line": 79,
        "text": "सुवर्णबिन्दुरक्षोभ्य इत्यनामिकाभ्यां नमः ।"
      },
      {
        "line": 80,
        "text": "निमिषोऽनिमिषः स्रग्वीति कनिष्ठिकाभ्यां नमः ।"
      },
      {
        "line": 81,
        "text": "रथाङ्गपाणिरक्षोभ्य इति करतलकरपृष्ठाभ्यां नमः ।"
      },
      {
        "line": 82,
        "text": "इति करन्यासः॥"
      },
      {
        "line": 83,
        "text": "अथ षडङ्गन्यासः"
      },
      {
        "line": 84,
        "text": "ॐ विश्वं विष्णुर्वषट्कार इति हृदयाय नमः ।"
      },
      {
        "line": 85,
        "text": "अमृतांशूद्भवो भानुरिति शिरसे स्वाहा ।"
      },
      {
        "line": 86,
        "text": "ब्रह्मण्यो ब्रह्मकृद्ब्रह्मेति शिखायै वषट् ।"
      },
      {
        "line": 87,
        "text": "सुवर्णबिन्दुरक्षोभ्य इति कवचाय हुम् ।"
      },
      {
        "line": 88,
        "text": "निमिषोऽनिमिषः स्रग्वीति नेत्रत्रयाय वौषट् ।"
      },
      {
        "line": 89,
        "text": "रथाङ्गपाणिरक्षोभ्य इत्यस्त्राय फट् ।"
      },
      {
        "line": 90,
        "text": "इति षडङ्गन्यासः ॥"
      },
      {
        "line": 91,
        "text": "श्रीकृष्णप्रीत्यर्थे विष्णोर्दिव्यसहस्रनामजपमहं करिष्ये इति सङ्कल्पः ।"
      },
      {
        "line": 92,
        "text": "अथ ध्यानम्-"
      },
      {
        "line": 93,
        "text": "क्षीरोदन्वत्प्रदेशे शुचिमणिविलसत्सैकतेर्मौक्तिकानां"
      },
      {
        "line": 94,
        "text": "मालाकॢप्तासनस्थः स्फटिकमणिनिभैर्मौक्तिकैर्मण्डिताङ्गः।"
      },
      {
        "line": 95,
        "text": "शुभ्रैरभ्रैरदभ्रैरुपरिविरचितैर्मुक्तपीयूष वर्षैः"
      },
      {
        "line": 96,
        "text": "आनन्दी नः पुनीयादरिनलिनगदा शङ्खपाणिर्मुकुन्दः॥१॥"
      },
      {
        "line": 97,
        "text": "भूः पादौ यस्य नाभिर्वियदसुरनिलश्चन्द्र सूर्यौ च नेत्रे"
      },
      {
        "line": 98,
        "text": "कर्णावाशाः शिरो द्यौर्मुखमपि दहनो यस्य वास्तेयमब्धिः।"
      },
      {
        "line": 99,
        "text": "अन्तःस्थं यस्य विश्वं सुरनरखगगोभोगिगन्धर्वदैत्यैः"
      },
      {
        "line": 100,
        "text": "चित्रं रंरम्यते तं त्रिभुवन वपुषं विष्णुमीशं नमामि॥२॥"
      },
      {
        "line": 101,
        "text": "ॐ शान्ताकारं भुजगशयनं पद्मनाभं सुरेशं"
      },
      {
        "line": 102,
        "text": "विश्वाधारं गगनसदृशं मेघवर्णं शुभाङ्गम्।"
      },
      {
        "line": 103,
        "text": "लक्ष्मीकान्तं कमलनयनं योगिभिर्ध्यानगम्यं"
      },
      {
        "line": 104,
        "text": "वन्दे विष्णुं भवभयहरं सर्वलोकैकनाथम्॥३॥"
      },
      {
        "line": 105,
        "text": "मेघश्यामं पीतकौशेयवासं"
      },
      {
        "line": 106,
        "text": "श्रीवत्साङ्कं कौस्तुभोद्भासिताङ्गम्।"
      },
      {
        "line": 107,
        "text": "पुण्योपेतं पुण्डरीकायताक्षं"
      },
      {
        "line": 108,
        "text": "विष्णुं वन्दे सर्वलोकैकनाथम्॥४॥"
      },
      {
        "line": 109,
        "text": "नमः समस्तभूतानामादिभूताय भूभृते।"
      },
      {
        "line": 110,
        "text": "अनेकरूपरूपाय विष्णवे प्रभविष्णवे॥५॥"
      },
      {
        "line": 111,
        "text": "सशङ्खचक्रं सकिरीटकुण्डलं"
      },
      {
        "line": 112,
        "text": "सपीतवस्त्रं सरसीरुहेक्षणम्।"
      },
      {
        "line": 113,
        "text": "सहारवक्षःस्थलकौस्तुभश्रियं"
      },
      {
        "line": 114,
        "text": "नमामि विष्णुं शिरसा चतुर्भुजम्॥६॥"
      },
      {
        "line": 115,
        "text": "छायायां पारिजातस्य हेमसिंहासनोपरि"
      },
      {
        "line": 116,
        "text": "आसीनमम्बुदश्याममायताक्षमलंकृतम् |"
      },
      {
        "line": 117,
        "text": "चन्द्राननं चतुर्बाहुं श्रीवत्साङ्कित वक्षसं"
      },
      {
        "line": 118,
        "text": "रुक्मिणी सत्यभामाभ्यां सहितं कृष्णमाश्रये॥७॥"
      },
      {
        "line": 119,
        "text": "स्तोत्रम्‌-"
      },
      {
        "line": 120,
        "text": "॥ हरिः ॐ ॥"
      },
      {
        "line": 121,
        "text": "विश्वं विष्णुर्वषट्कारो भूतभव्यभवत्प्रभुः।"
      },
      {
        "line": 122,
        "text": "भूतकृद्भूतभृद्भावो भूतात्मा भूतभावनः॥१॥"
      },
      {
        "line": 123,
        "text": "पूतात्मा परमात्मा च मुक्तानां परमा गतिः।"
      },
      {
        "line": 124,
        "text": "अव्ययः पुरुषः साक्षी क्षेत्रज्ञोऽक्षर एव च॥२॥"
      },
      {
        "line": 125,
        "text": "योगो योगविदां नेता प्रधानपुरुषेश्वरः।"
      },
      {
        "line": 126,
        "text": "नारसिंहवपुः श्रीमान् केशवः पुरुषोत्तमः॥३॥"
      },
      {
        "line": 127,
        "text": "सर्वः शर्वः शिवः स्थाणुर्भूतादिर्निधिरव्ययः।"
      },
      {
        "line": 128,
        "text": "संभवो भावनो भर्ता प्रभवः प्रभुरीश्वरः॥४॥"
      },
      {
        "line": 129,
        "text": "स्वयंभूः शम्भुरादित्यः पुष्कराक्षो महास्वनः।"
      },
      {
        "line": 130,
        "text": "अनादिनिधनो धाता विधाता धातुरुत्तमः॥५॥"
      },
      {
        "line": 131,
        "text": "अप्रमेयो हृषीकेशः पद्मनाभोऽमरप्रभुः।"
      },
      {
        "line": 132,
        "text": "विश्वकर्मा मनुस्त्वष्टा स्थविष्ठः स्थविरो ध्रुवः॥६॥"
      },
      {
        "line": 133,
        "text": "अग्राह्यः शाश्वतः कृष्णो लोहिताक्षः प्रतर्दनः।"
      },
      {
        "line": 134,
        "text": "प्रभूतस्त्रिककुब्धाम पवित्रं मङ्गलं परम्॥७॥"
      },
      {
        "line": 135,
        "text": "ईशानः प्राणदः प्राणो ज्येष्ठः श्रेष्ठः प्रजापतिः।"
      },
      {
        "line": 136,
        "text": "हिरण्यगर्भो भूगर्भो माधवो मधुसूदनः॥८॥"
      },
      {
        "line": 137,
        "text": "ईश्वरो विक्रमी धन्वी मेधावी विक्रमः क्रमः।"
      },
      {
        "line": 138,
        "text": "अनुत्तमो दुराधर्षः कृतज्ञः कृतिरात्मवान्॥९॥"
      },
      {
        "line": 139,
        "text": "सुरेशः शरणं शर्म विश्वरेताः प्रजाभवः।"
      },
      {
        "line": 140,
        "text": "अहः संवत्सरो व्यालः प्रत्ययः सर्वदर्शनः॥१०॥"
      },
      {
        "line": 141,
        "text": "अजः सर्वेश्वरः सिद्धः सिद्धिः सर्वादिरच्युतः।"
      },
      {
        "line": 142,
        "text": "वृषाकपिरमेयात्मा सर्वयोगविनिःसृतः॥११॥"
      },
      {
        "line": 143,
        "text": "वसुर्वसुमनाः सत्यः समात्माऽसम्मितः समः।"
      },
      {
        "line": 144,
        "text": "अमोघः पुण्डरीकाक्षो वृषकर्मा वृषाकृतिः॥१२॥"
      },
      {
        "line": 145,
        "text": "रुद्रो बहुशिरा बभ्रुर्विश्वयोनिः शुचिश्रवाः।"
      },
      {
        "line": 146,
        "text": "अमृतः शाश्वत स्थाणुर्वरारोहो महातपाः॥१३॥"
      },
      {
        "line": 147,
        "text": "सर्वगः सर्वविद्भानुर्विष्वक्सेनो जनार्दनः।"
      },
      {
        "line": 148,
        "text": "वेदो वेदविदव्यङ्गो वेदाङ्गो वेदवित् कविः॥१४॥"
      },
      {
        "line": 149,
        "text": "लोकाध्यक्षः सुराध्यक्षो धर्माध्यक्षः कृताकृतः।"
      },
      {
        "line": 150,
        "text": "चतुरात्मा चतुर्व्यूहश्चतुर्दंष्ट्रश्चतुर्भुजः॥१५॥"
      },
      {
        "line": 151,
        "text": "भ्राजिष्णुर्भोजनं भोक्ता सहिष्णुर्जगदादिजः।"
      },
      {
        "line": 152,
        "text": "अनघो विजयो जेता विश्वयोनिः पुनर्वसुः॥१६॥"
      },
      {
        "line": 153,
        "text": "उपेन्द्रो वामनः प्रांशुरमोघः शुचिरूर्जितः।"
      },
      {
        "line": 154,
        "text": "अतीन्द्रः संग्रहः सर्गो धृतात्मा नियमो यमः॥१७॥"
      },
      {
        "line": 155,
        "text": "वेद्यो वैद्यः सदायोगी वीरहा माधवो मधुः।"
      },
      {
        "line": 156,
        "text": "अतीन्द्रियो महामायो महोत्साहो महाबलः॥१८॥"
      },
      {
        "line": 157,
        "text": "महाबुद्धिर्महावीर्यो महाशक्तिर्महाद्युतिः।"
      },
      {
        "line": 158,
        "text": "अनिर्देश्यवपुः श्रीमानमेयात्मा महाद्रिधृक्॥१९॥"
      },
      {
        "line": 159,
        "text": "महेष्वासो महीभर्ता श्रीनिवासः सतां गतिः।"
      },
      {
        "line": 160,
        "text": "अनिरुद्धः सुरानन्दो गोविन्दो गोविदां पतिः॥२०॥"
      },
      {
        "line": 161,
        "text": "मरीचिर्दमनो हंसः सुपर्णो भुजगोत्तमः।"
      },
      {
        "line": 162,
        "text": "हिरण्यनाभः सुतपाः पद्मनाभः प्रजापतिः॥२१॥"
      },
      {
        "line": 163,
        "text": "अमृत्युः सर्वदृक् सिंहः सन्धाता सन्धिमान् स्थिरः।"
      },
      {
        "line": 164,
        "text": "अजो दुर्मर्षणः शास्ता विश्रुतात्मा सुरारिहा॥२२॥"
      },
      {
        "line": 165,
        "text": "गुरुर्गुरुतमो धाम सत्यः सत्यपराक्रमः।"
      },
      {
        "line": 166,
        "text": "निमिषोऽनिमिषः स्रग्वी वाचस्पतिरुदारधीः॥२३॥"
      },
      {
        "line": 167,
        "text": "अग्रणीर्ग्रामणीः श्रीमान् न्यायो नेता समीरणः।"
      },
      {
        "line": 168,
        "text": "सहस्रमूर्धा विश्वात्मा सहस्राक्षः सहस्रपात्॥२४॥"
      },
      {
        "line": 169,
        "text": "आवर्तनो निवृत्तात्मा संवृतः संप्रमर्दनः।"
      },
      {
        "line": 170,
        "text": "अहः संवर्तको वह्निरनिलो धरणीधरः॥२५॥"
      },
      {
        "line": 171,
        "text": "सुप्रसादः प्रसन्नात्मा विश्वधृग्विश्वभुग्विभुः।"
      },
      {
        "line": 172,
        "text": "सत्कर्ता सत्कृतः साधुर्जह्नुर्नारायणो नरः॥२६॥"
      },
      {
        "line": 173,
        "text": "असंख्येयोऽप्रमेयात्मा विशिष्टः शिष्टकृच्छुचिः।"
      },
      {
        "line": 174,
        "text": "सिद्धार्थः सिद्धसंकल्पः सिद्धिदः सिद्धिसाधनः॥२७॥"
      },
      {
        "line": 175,
        "text": "वृषाही वृषभो विष्णुर्वृषपर्वा वृषोदरः।"
      },
      {
        "line": 176,
        "text": "वर्धनो वर्धमानश्च विविक्तः श्रुतिसागरः॥२८॥"
      },
      {
        "line": 177,
        "text": "सुभुजो दुर्धरो वाग्मी महेन्द्रो वसुदो वसुः।"
      },
      {
        "line": 178,
        "text": "नैकरूपो बृहद्रूपः शिपिविष्टः प्रकाशनः॥२९॥"
      },
      {
        "line": 179,
        "text": "ओजस्तेजोद्युतिधरः प्रकाशात्मा प्रतापनः।"
      },
      {
        "line": 180,
        "text": "ऋद्धः स्पष्टाक्षरो मन्त्रश्चन्द्रांशुर्भास्करद्युतिः॥३०॥"
      },
      {
        "line": 181,
        "text": "अमृतांशूद्भवो भानुः शशबिन्दुः सुरेश्वरः।"
      },
      {
        "line": 182,
        "text": "औषधं जगतः सेतुः सत्यधर्मपराक्रमः॥३१॥"
      },
      {
        "line": 183,
        "text": "भूतभव्यभवन्नाथः पवनः पावनोऽनलः।"
      },
      {
        "line": 184,
        "text": "कामहा कामकृत्कान्तः कामः कामप्रदः प्रभुः॥३२॥"
      },
      {
        "line": 185,
        "text": "युगादिकृद्युगावर्तो नैकमायो महाशनः।"
      },
      {
        "line": 186,
        "text": "अदृश्यो व्यक्तरूपश्च सहस्रजिदनन्तजित्॥३३॥"
      },
      {
        "line": 187,
        "text": "इष्टोऽविशिष्टः शिष्टेष्टः शिखण्डी नहुषो वृषः।"
      },
      {
        "line": 188,
        "text": "क्रोधहा क्रोधकृत्कर्ता विश्वबाहुर्महीधरः॥३४॥"
      },
      {
        "line": 189,
        "text": "अच्युतः प्रथितः प्राणः प्राणदो वासवानुजः।"
      },
      {
        "line": 190,
        "text": "अपांनिधिरधिष्ठानमप्रमत्तः प्रतिष्ठितः॥३५॥"
      },
      {
        "line": 191,
        "text": "स्कन्दः स्कन्दधरो धुर्यो वरदो वायुवाहनः।"
      },
      {
        "line": 192,
        "text": "वासुदेवो बृहद्भानुरादिदेवः पुरन्दरः॥३६॥"
      },
      {
        "line": 193,
        "text": "अशोकस्तारणस्तारः शूरः शौरिर्जनेश्वरः।"
      },
      {
        "line": 194,
        "text": "अनुकूलः शतावर्तः पद्मी पद्मनिभेक्षणः॥३७॥"
      },
      {
        "line": 195,
        "text": "पद्मनाभोऽरविन्दाक्षः पद्मगर्भः शरीरभृत्।"
      },
      {
        "line": 196,
        "text": "महर्द्धिरृद्धो वृद्धात्मा महाक्षो गरुडध्वजः॥३८॥"
      },
      {
        "line": 197,
        "text": "अतुलः शरभो भीमः समयज्ञो हविर्हरिः।"
      },
      {
        "line": 198,
        "text": "सर्वलक्षणलक्षण्यो लक्ष्मीवान् समितिञ्जयः॥३९॥"
      },
      {
        "line": 199,
        "text": "विक्षरो रोहितो मार्गो हेतुर्दामोदरः सहः।"
      },
      {
        "line": 200,
        "text": "महीधरो महाभागो वेगवानमिताशनः॥४०॥"
      },
      {
        "line": 201,
        "text": "उद्भवः क्षोभणो देवः श्रीगर्भः परमेश्वरः।"
      },
      {
        "line": 202,
        "text": "करणं कारणं कर्ता विकर्ता गहनो गुहः॥४१॥"
      },
      {
        "line": 203,
        "text": "व्यवसायो व्यवस्थानः संस्थानः स्थानदो ध्रुवः।"
      },
      {
        "line": 204,
        "text": "परर्द्धिः परमस्पष्टस्तुष्टः पुष्टः शुभेक्षणः॥४२॥"
      },
      {
        "line": 205,
        "text": "रामो विरामो विरजो (विरतो) मार्गो नेयो नयोऽनयः।"
      },
      {
        "line": 206,
        "text": "वीरः शक्तिमतां श्रेष्ठो धर्मो धर्मविदुत्तमः॥४३॥"
      },
      {
        "line": 207,
        "text": "वैकुण्ठः पुरुषः प्राणः प्राणदः प्रणवः पृथुः।"
      },
      {
        "line": 208,
        "text": "हिरण्यगर्भः शत्रुघ्नो व्याप्तो वायुरधोक्षजः॥४४॥"
      },
      {
        "line": 209,
        "text": "ऋतुः सुदर्शनः कालः परमेष्ठी परिग्रहः।"
      },
      {
        "line": 210,
        "text": "उग्रः संवत्सरो दक्षो विश्रामो विश्वदक्षिणः॥४५॥"
      },
      {
        "line": 211,
        "text": "विस्तारः स्थावरस्थाणुः प्रमाणं बीजमव्ययम्।"
      },
      {
        "line": 212,
        "text": "अर्थोऽनर्थो महाकोशो महाभोगो महाधनः॥४६॥"
      },
      {
        "line": 213,
        "text": "अनिर्विण्णः स्थविष्ठोऽभूर्धर्मयूपो महामखः।"
      },
      {
        "line": 214,
        "text": "नक्षत्रनेमिर्नक्षत्री क्षमः क्षामः समीहनः॥४७॥"
      },
      {
        "line": 215,
        "text": "यज्ञ इज्यो महेज्यश्च क्रतुः सत्रं सतां गतिः।"
      },
      {
        "line": 216,
        "text": "सर्वदर्शी विमुक्तात्मा सर्वज्ञो ज्ञानमुत्तमम्॥४८॥"
      },
      {
        "line": 217,
        "text": "सुव्रतः सुमुखः सूक्ष्मः सुघोषः सुखदः सुहृत्।"
      },
      {
        "line": 218,
        "text": "मनोहरो जितक्रोधो वीरबाहुर्विदारणः॥४९॥"
      },
      {
        "line": 219,
        "text": "स्वापनः स्ववशो व्यापी नैकात्मा नैककर्मकृत्।"
      },
      {
        "line": 220,
        "text": "वत्सरो वत्सलो वत्सी रत्नगर्भो धनेश्वरः॥५०॥"
      },
      {
        "line": 221,
        "text": "धर्मगुब्धर्मकृद्धर्मी सदसत्क्षरमक्षरम्।"
      },
      {
        "line": 222,
        "text": "अविज्ञाता सहस्रांशुर्विधाता कृतलक्षणः॥५१॥"
      },
      {
        "line": 223,
        "text": "गभस्तिनेमिः सत्त्वस्थः सिंहो भूतमहेश्वरः।"
      },
      {
        "line": 224,
        "text": "आदिदेवो महादेवो देवेशो देवभृद्गुरुः॥५२॥"
      },
      {
        "line": 225,
        "text": "उत्तरो गोपतिर्गोप्ता ज्ञानगम्यः पुरातनः।"
      },
      {
        "line": 226,
        "text": "शरीरभूतभृद्भोक्ता कपीन्द्रो भूरिदक्षिणः॥५३॥"
      },
      {
        "line": 227,
        "text": "सोमपोऽमृतपः सोमः पुरुजित्पुरुसत्तमः।"
      },
      {
        "line": 228,
        "text": "विनयो जयः सत्यसंधो दाशार्हः सात्त्वतांपतिः॥५४॥"
      },
      {
        "line": 229,
        "text": "जीवो विनयिता साक्षी मुकुन्दोऽमितविक्रमः।"
      },
      {
        "line": 230,
        "text": "अम्भोनिधिरनन्तात्मा महोदधिशयोऽन्तकः॥५५॥"
      },
      {
        "line": 231,
        "text": "अजो महार्हः स्वाभाव्यो जितामित्रः प्रमोदनः।"
      },
      {
        "line": 232,
        "text": "आनन्दो नन्दनो नन्दः सत्यधर्मा त्रिविक्रमः॥५६॥"
      },
      {
        "line": 233,
        "text": "महर्षिः कपिलाचार्यः कृतज्ञो मेदिनीपतिः।"
      },
      {
        "line": 234,
        "text": "त्रिपदस्त्रिदशाध्यक्षो महाशृङ्गः कृतान्तकृत्॥५७॥"
      },
      {
        "line": 235,
        "text": "महावराहो गोविन्दः सुषेणः कनकाङ्गदी।"
      },
      {
        "line": 236,
        "text": "गुह्यो गभीरो गहनो गुप्तश्चक्रगदाधरः॥५८॥"
      },
      {
        "line": 237,
        "text": "वेधाः स्वाङ्गोऽजितः कृष्णो दृढः संकर्षणोऽच्युतः।"
      },
      {
        "line": 238,
        "text": "वरुणो वारुणो वृक्षः पुष्कराक्षो महामनाः॥५९॥"
      },
      {
        "line": 239,
        "text": "भगवान् भगहाऽऽनन्दी वनमाली हलायुधः।"
      },
      {
        "line": 240,
        "text": "आदित्यो ज्योतिरादित्यः सहिष्णुर्गतिसत्तमः॥६०॥"
      },
      {
        "line": 241,
        "text": "सुधन्वा खण्डपरशुर्दारुणो द्रविणप्रदः।"
      },
      {
        "line": 242,
        "text": "दिवःस्पृक् सर्वदृग्व्यासो वाचस्पतिरयोनिजः॥६१॥"
      },
      {
        "line": 243,
        "text": "त्रिसामा सामगः साम निर्वाणं भेषजं भिषक्।"
      },
      {
        "line": 244,
        "text": "संन्यासकृच्छमः शान्तो निष्ठा शान्तिः परायणम्॥६२॥"
      },
      {
        "line": 245,
        "text": "शुभाङ्गः शान्तिदः स्रष्टा कुमुदः कुवलेशयः।"
      },
      {
        "line": 246,
        "text": "गोहितो गोपतिर्गोप्ता वृषभाक्षो वृषप्रियः॥६३॥"
      },
      {
        "line": 247,
        "text": "अनिवर्ती निवृत्तात्मा संक्षेप्ता क्षेमकृच्छिवः।"
      },
      {
        "line": 248,
        "text": "श्रीवत्सवक्षाः श्रीवासः श्रीपतिः श्रीमतांवरः॥६४॥"
      },
      {
        "line": 249,
        "text": "श्रीदः श्रीशः श्रीनिवासः श्रीनिधिः श्रीविभावनः।"
      },
      {
        "line": 250,
        "text": "श्रीधरः श्रीकरः श्रेयः श्रीमाँल्लोकत्रयाश्रयः॥६५॥"
      },
      {
        "line": 251,
        "text": "स्वक्षः स्वङ्गः शतानन्दो नन्दिर्ज्योतिर्गणेश्वरः।"
      },
      {
        "line": 252,
        "text": "विजितात्माऽविधेयात्मा सत्कीर्तिश्छिन्नसंशयः॥६६॥"
      },
      {
        "line": 253,
        "text": "उदीर्णः सर्वतश्चक्षुरनीशः शाश्वतस्थिरः।"
      },
      {
        "line": 254,
        "text": "भूशयो भूषणो भूतिर्विशोकः शोकनाशनः॥६७॥"
      },
      {
        "line": 255,
        "text": "अर्चिष्मानर्चितः कुम्भो विशुद्धात्मा विशोधनः।"
      },
      {
        "line": 256,
        "text": "अनिरुद्धोऽप्रतिरथः प्रद्युम्नोऽमितविक्रमः॥६८॥"
      },
      {
        "line": 257,
        "text": "कालनेमिनिहा वीरः शौरिः शूरजनेश्वरः।"
      },
      {
        "line": 258,
        "text": "त्रिलोकात्मा त्रिलोकेशः केशवः केशिहा हरिः॥६९॥"
      },
      {
        "line": 259,
        "text": "कामदेवः कामपालः कामी कान्तः कृतागमः।"
      },
      {
        "line": 260,
        "text": "अनिर्देश्यवपुर्विष्णुर्वीरोऽनन्तो धनंजयः॥७०॥"
      },
      {
        "line": 261,
        "text": "ब्रह्मण्यो ब्रह्मकृद् ब्रह्मा ब्रह्म ब्रह्मविवर्धनः।"
      },
      {
        "line": 262,
        "text": "ब्रह्मविद् ब्राह्मणो ब्रह्मी ब्रह्मज्ञो ब्राह्मणप्रियः॥७१॥"
      },
      {
        "line": 263,
        "text": "महाक्रमो महाकर्मा महातेजा महोरगः।"
      },
      {
        "line": 264,
        "text": "महाक्रतुर्महायज्वा महायज्ञो महाहविः॥७२॥"
      },
      {
        "line": 265,
        "text": "स्तव्यः स्तवप्रियः स्तोत्रं स्तुतिः स्तोता रणप्रियः।"
      },
      {
        "line": 266,
        "text": "पूर्णः पूरयिता पुण्यः पुण्यकीर्तिरनामयः॥७३॥"
      },
      {
        "line": 267,
        "text": "मनोजवस्तीर्थकरो वसुरेता वसुप्रदः।"
      },
      {
        "line": 268,
        "text": "वसुप्रदो वासुदेवो वसुर्वसुमना हविः॥७४॥"
      },
      {
        "line": 269,
        "text": "सद्गतिः सत्कृतिः सत्ता सद्भूतिः सत्परायणः।"
      },
      {
        "line": 270,
        "text": "शूरसेनो यदुश्रेष्ठः सन्निवासः सुयामुनः॥७५॥"
      },
      {
        "line": 271,
        "text": "भूतावासो वासुदेवः सर्वासुनिलयोऽनलः।"
      },
      {
        "line": 272,
        "text": "दर्पहा दर्पदो दृप्तो दुर्धरोऽथापराजितः॥७६॥"
      },
      {
        "line": 273,
        "text": "विश्वमूर्तिर्महामूर्तिर्दीप्तमूर्तिरमूर्तिमान्।"
      },
      {
        "line": 274,
        "text": "अनेकमूर्तिरव्यक्तः शतमूर्तिः शताननः॥७७॥"
      },
      {
        "line": 275,
        "text": "एको नैकः सवः कः किं यत् तत्पदमनुत्तमम्।"
      },
      {
        "line": 276,
        "text": "लोकबन्धुर्लोकनाथो माधवो भक्तवत्सलः॥७८॥"
      },
      {
        "line": 277,
        "text": "सुवर्णवर्णो हेमाङ्गो वराङ्गश्चन्दनाङ्गदी।"
      },
      {
        "line": 278,
        "text": "वीरहा विषमः शून्यो घृताशीरचलश्चलः॥७९॥"
      },
      {
        "line": 279,
        "text": "अमानी मानदो मान्यो लोकस्वामी त्रिलोकधृक्।"
      },
      {
        "line": 280,
        "text": "सुमेधा मेधजो धन्यः सत्यमेधा धराधरः॥८०॥"
      },
      {
        "line": 281,
        "text": "तेजोवृषो द्युतिधरः सर्वशस्त्रभृतां वरः।"
      },
      {
        "line": 282,
        "text": "प्रग्रहो निग्रहो व्यग्रो नैकशृङ्गो गदाग्रजः॥८१॥"
      },
      {
        "line": 283,
        "text": "चतुर्मूर्तिश्चतुर्बाहुश्चतुर्व्यूहश्चतुर्गतिः।"
      },
      {
        "line": 284,
        "text": "चतुरात्मा चतुर्भावश्चतुर्वेदविदेकपात्॥८२॥"
      },
      {
        "line": 285,
        "text": "समावर्तोऽनिवृत्तात्मा दुर्जयो दुरतिक्रमः।"
      },
      {
        "line": 286,
        "text": "दुर्लभो दुर्गमो दुर्गो दुरावासो दुरारिहा॥८३॥"
      },
      {
        "line": 287,
        "text": "शुभाङ्गो लोकसारङ्गः सुतन्तुस्तन्तुवर्धनः।"
      },
      {
        "line": 288,
        "text": "इन्द्रकर्मा महाकर्मा कृतकर्मा कृतागमः॥८४॥"
      },
      {
        "line": 289,
        "text": "उद्भवः सुन्दरः सुन्दो रत्ननाभः सुलोचनः।"
      },
      {
        "line": 290,
        "text": "अर्को वाजसनः शृङ्गी जयन्तः सर्वविज्जयी॥८५॥"
      },
      {
        "line": 291,
        "text": "सुवर्णबिन्दुरक्षोभ्यः सर्ववागीश्वरेश्वरः।"
      },
      {
        "line": 292,
        "text": "महाह्रदो महागर्तो महाभूतो महानिधिः॥८६॥"
      },
      {
        "line": 293,
        "text": "कुमुदः कुन्दरः कुन्दः पर्जन्यः पावनोऽनिलः।"
      },
      {
        "line": 294,
        "text": "अमृतांशोऽमृतवपुः सर्वज्ञः सर्वतोमुखः॥८७॥"
      },
      {
        "line": 295,
        "text": "सुलभः सुव्रतः सिद्धः शत्रुजिच्छत्रुतापनः।"
      },
      {
        "line": 296,
        "text": "न्यग्रोधोऽदुम्बरोऽश्वत्थश्चाणूरान्ध्रनिषूदनः॥८८॥"
      },
      {
        "line": 297,
        "text": "सहस्रार्चिः सप्तजिह्वः सप्तैधाः सप्तवाहनः।"
      },
      {
        "line": 298,
        "text": "अमूर्तिरनघोऽचिन्त्यो भयकृद्भयनाशनः॥८९॥"
      },
      {
        "line": 299,
        "text": "अणुर्बृहत्कृशः स्थूलो गुणभृन्निर्गुणो महान्।"
      },
      {
        "line": 300,
        "text": "अधृतः स्वधृतः स्वास्यः प्राग्वंशो वंशवर्धनः॥९०॥"
      },
      {
        "line": 301,
        "text": "भारभृत् कथितो योगी योगीशः सर्वकामदः।"
      },
      {
        "line": 302,
        "text": "आश्रमः श्रमणः क्षामः सुपर्णो वायुवाहनः॥९१॥"
      },
      {
        "line": 303,
        "text": "धनुर्धरो धनुर्वेदो दण्डो दमयिता दमः।"
      },
      {
        "line": 304,
        "text": "अपराजितः सर्वसहो नियन्ताऽनियमोऽयमः॥९२॥"
      },
      {
        "line": 305,
        "text": "सत्त्ववान् सात्त्विकः सत्यः सत्यधर्मपरायणः।"
      },
      {
        "line": 306,
        "text": "अभिप्रायः प्रियार्होऽर्हः प्रियकृत् प्रीतिवर्धनः॥९३॥"
      },
      {
        "line": 307,
        "text": "विहायसगतिर्ज्योतिः सुरुचिर्हुतभुग्विभुः।"
      },
      {
        "line": 308,
        "text": "रविर्विरोचनः सूर्यः सविता रविलोचनः॥९४॥"
      },
      {
        "line": 309,
        "text": "अनन्तो हुतभुग्भोक्ता सुखदो नैकजोऽग्रजः।"
      },
      {
        "line": 310,
        "text": "अनिर्विण्णः सदामर्षी लोकाधिष्ठानमद्भुतः॥९५॥"
      },
      {
        "line": 311,
        "text": "सनात्सनातनतमः कपिलः कपिरव्ययः।"
      },
      {
        "line": 312,
        "text": "स्वस्तिदः स्वस्तिकृत्स्वस्ति स्वस्तिभुक्स्वस्तिदक्षिणः॥९६॥"
      },
      {
        "line": 313,
        "text": "अरौद्रः कुण्डली चक्री विक्रम्यूर्जितशासनः।"
      },
      {
        "line": 314,
        "text": "शब्दातिगः शब्दसहः शिशिरः शर्वरीकरः॥९७॥"
      },
      {
        "line": 315,
        "text": "अक्रूरः पेशलो दक्षो दक्षिणः क्षमिणांवरः।"
      },
      {
        "line": 316,
        "text": "विद्वत्तमो वीतभयः पुण्यश्रवणकीर्तनः॥९८॥"
      },
      {
        "line": 317,
        "text": "उत्तारणो दुष्कृतिहा पुण्यो दुःस्वप्ननाशनः।"
      },
      {
        "line": 318,
        "text": "वीरहा रक्षणः सन्तो जीवनः पर्यवस्थितः॥९९॥"
      },
      {
        "line": 319,
        "text": "अनन्तरूपोऽनन्तश्रीर्जितमन्युर्भयापहः।"
      },
      {
        "line": 320,
        "text": "चतुरश्रो गभीरात्मा विदिशो व्यादिशो दिशः॥१००॥"
      },
      {
        "line": 321,
        "text": "अनादिर्भूर्भुवो लक्ष्मीः सुवीरो रुचिराङ्गदः।"
      },
      {
        "line": 322,
        "text": "जननो जनजन्मादिर्भीमो भीमपराक्रमः॥१०१॥"
      },
      {
        "line": 323,
        "text": "आधारनिलयोऽधाता पुष्पहासः प्रजागरः।"
      },
      {
        "line": 324,
        "text": "ऊर्ध्वगः सत्पथाचारः प्राणदः प्रणवः पणः॥१०२॥"
      },
      {
        "line": 325,
        "text": "प्रमाणं प्राणनिलयः प्राणभृत्प्राणजीवनः।"
      },
      {
        "line": 326,
        "text": "तत्त्वं तत्त्वविदेकात्मा जन्ममृत्युजरातिगः॥१०३॥"
      },
      {
        "line": 327,
        "text": "भूर्भुवःस्वस्तरुस्तारः सविता प्रपितामहः।"
      },
      {
        "line": 328,
        "text": "यज्ञो यज्ञपतिर्यज्वा यज्ञाङ्गो यज्ञवाहनः॥१०४॥"
      },
      {
        "line": 329,
        "text": "यज्ञभृद् यज्ञकृद् यज्ञी यज्ञभुक् यज्ञसाधनः।"
      },
      {
        "line": 330,
        "text": "यज्ञान्तकृद् यज्ञगुह्यमन्नमन्नाद एव च॥१०५॥"
      },
      {
        "line": 331,
        "text": "आत्मयोनिः स्वयंजातो वैखानः सामगायनः।"
      },
      {
        "line": 332,
        "text": "देवकीनन्दनः स्रष्टा क्षितीशः पापनाशनः॥१०६॥"
      },
      {
        "line": 333,
        "text": "शङ्खभृन्नन्दकी चक्री शार्ङ्गधन्वा गदाधरः।"
      },
      {
        "line": 334,
        "text": "रथाङ्गपाणिरक्षोभ्यः सर्वप्रहरणायुधः॥१०७॥"
      },
      {
        "line": 335,
        "text": "सर्वप्रहरणायुध ॐ नम इति।"
      },
      {
        "line": 336,
        "text": "वनमाली गदी शार्ङ्गी शङ्खी चक्री च नन्दकी।"
      },
      {
        "line": 337,
        "text": "श्रीमान् नारायणो विष्णुर्वासुदेवोऽभिरक्षतु॥१०८॥"
      },
      {
        "line": 338,
        "text": "श्री वासुदेवोऽभिरक्षतु ॐ नम इति।"
      }
    ]
  }
}