{
  "id": "sri_rama_raksha_stotram_hi",
  "name_en": "Shri Ram Raksha Stotram",
  "name_te": "శ్రీ రామ రక్షా స్తోత్రం",
  "name_hi": "श्री राम रक्षा स्तोत्रम्",
  "language": "hi",
  "category": "stotram",
  "addedDate": "2025-07-24",
  "content": {
    "verses": [
      {
        "line": 1,
        "text": "श्री राम रक्षा स्तोत्रम् (Shri Ram Raksha Stotram)"
      },
      {
        "line": 2,
        "text": "विनियोग:"
      },
      {
        "line": 3,
        "text": "अस्य श्रीरामरक्षास्त्रोतमन्त्रस्य बुधकौशिक ऋषिः ।"
      },
      {
        "line": 4,
        "text": "श्री सीतारामचंद्रो देवता ।"
      },
      {
        "line": 5,
        "text": "अनुष्टुप छंदः। सीता शक्तिः ।"
      },
      {
        "line": 6,
        "text": "श्रीमान हनुमान कीलकम ।"
      },
      {
        "line": 7,
        "text": "श्री सीतारामचंद्रप्रीत्यर्थे रामरक्षास्त्रोतजपे विनियोगः ।"
      },
      {
        "line": 8,
        "text": "अथ ध्यानम्‌:"
      },
      {
        "line": 9,
        "text": "ध्यायेदाजानुबाहुं धृतशरधनुषं बद्धपदमासनस्थं,"
      },
      {
        "line": 10,
        "text": "पीतं वासो वसानं नवकमल दल स्पर्धिनेत्रम् प्रसन्नम ।"
      },
      {
        "line": 11,
        "text": "वामांकारूढ़ सीता मुखकमलमिलल्लोचनम्नी,"
      },
      {
        "line": 12,
        "text": "रदाभम् नानालंकारदीप्तं दधतमुरुजटामण्डलम् रामचंद्रम ॥"
      },
      {
        "line": 13,
        "text": "राम रक्षा स्तोत्रम्:"
      },
      {
        "line": 14,
        "text": "चरितं रघुनाथस्य शतकोटि प्रविस्तरम् ।"
      },
      {
        "line": 15,
        "text": "एकैकमक्षरं पुंसां महापातकनाशनम् ॥1॥"
      },
      {
        "line": 16,
        "text": "ध्यात्वा नीलोत्पलश्यामं रामं राजीवलोचनम् ।"
      },
      {
        "line": 17,
        "text": "जानकीलक्ष्मणोपेतं जटामुकुटमण्डितं ॥2॥"
      },
      {
        "line": 18,
        "text": "सासितूणधनुर्बाणपाणिं नक्तंचरान्तकम् ।"
      },
      {
        "line": 19,
        "text": "स्वलीलया जगत्त्रातुमाविर्भूतमजं विभुम् ॥3॥"
      },
      {
        "line": 20,
        "text": "रामरक्षां पठेत प्राज्ञः पापघ्नीं सर्वकामदाम् ।"
      },
      {
        "line": 21,
        "text": "शिरो मे राघवः पातु भालं दशरथात्मजः ॥4॥"
      },
      {
        "line": 22,
        "text": "कौसल्येयो दृशो पातु विश्वामित्रप्रियः श्रुति ।"
      },
      {
        "line": 23,
        "text": "घ्राणं पातु मखत्राता मुखं सौमित्रिवत्सलः ॥5॥"
      },
      {
        "line": 24,
        "text": "जिह्वां विद्यानिधिः पातु कण्ठं भरतवन्दितः ।"
      },
      {
        "line": 25,
        "text": "स्कन्धौ दिव्यायुधः पातु भुजौ भग्नेशकार्मुकः ॥6॥"
      },
      {
        "line": 26,
        "text": "करौ सीतापतिः पातु हृदयं जामदग्न्यजित ।"
      },
      {
        "line": 27,
        "text": "मध्यं पातु खरध्वंसी नाभिं जाम्बवदाश्रयः ॥7॥"
      },
      {
        "line": 28,
        "text": "सुग्रीवेशः कटी पातु सक्थिनी हनुमत्प्रभुः ।"
      },
      {
        "line": 29,
        "text": "उरु रघूत्तमः पातु रक्षःकुलविनाशकृताः ॥8॥"
      },
      {
        "line": 30,
        "text": "जानुनी सेतुकृत पातु जंघे दशमुखांतकः ।"
      },
      {
        "line": 31,
        "text": "पादौ विभीषणश्रीदः पातु रामअखिलं वपुः ॥9॥"
      },
      {
        "line": 32,
        "text": "एतां रामबलोपेतां रक्षां यः सुकृति पठेत ।"
      },
      {
        "line": 33,
        "text": "स चिरायुः सुखी पुत्री विजयी विनयी भवेत् ॥10॥"
      },
      {
        "line": 34,
        "text": "पातालभूतल व्योम चारिणश्छद्मचारिणः ।"
      },
      {
        "line": 35,
        "text": "न द्रष्टुमपि शक्तास्ते रक्षितं रामनामभिः ॥11॥"
      },
      {
        "line": 36,
        "text": "रामेति रामभद्रेति रामचंद्रेति वा स्मरन ।"
      },
      {
        "line": 37,
        "text": "नरौ न लिप्यते पापैर्भुक्तिं मुक्तिं च विन्दति ॥12॥"
      },
      {
        "line": 38,
        "text": "जगज्जैत्रैकमन्त्रेण रामनाम्नाभिरक्षितम् ।"
      },
      {
        "line": 39,
        "text": "यः कण्ठे धारयेत्तस्य करस्थाः सर्वसिद्धयः ॥13॥"
      },
      {
        "line": 40,
        "text": "वज्रपञ्जरनामेदं यो रामकवचं स्मरेत ।"
      },
      {
        "line": 41,
        "text": "अव्याहताज्ञाः सर्वत्र लभते जयमंगलम् ॥14॥"
      },
      {
        "line": 42,
        "text": "आदिष्टवान् यथा स्वप्ने रामरक्षामिमां हरः ।"
      },
      {
        "line": 43,
        "text": "तथा लिखितवान् प्रातः प्रबुद्धो बुधकौशिकः ॥15॥"
      },
      {
        "line": 44,
        "text": "आरामः कल्पवृक्षाणां विरामः सकलापदाम् ।"
      },
      {
        "line": 45,
        "text": "अभिरामस्त्रिलोकानां रामः श्रीमान स नः प्रभुः ॥16॥"
      },
      {
        "line": 46,
        "text": "तरुणौ रूपसम्पन्नौ सुकुमारौ महाबलौ ।"
      },
      {
        "line": 47,
        "text": "पुण्डरीकविशालाक्षौ चीरकृष्णाजिनाम्बरौ ॥17॥"
      },
      {
        "line": 48,
        "text": "फलमूलाशिनौ दान्तौ तापसौ ब्रह्मचारिणौ ।"
      },
      {
        "line": 49,
        "text": "पुत्रौ दशरथस्यैतौ भ्रातरौ रामलक्ष्मणौ ॥18॥"
      },
      {
        "line": 50,
        "text": "शरण्यौ सर्वसत्वानां श्रेष्ठौ सर्वधनुष्मताम् ।"
      },
      {
        "line": 51,
        "text": "रक्षःकुलनिहन्तारौ त्रायेतां नो रघूत्तमौ ॥19॥"
      },
      {
        "line": 52,
        "text": "आत्तसज्जधनुषाविषुस्पृशा वक्ष याशुगनिषङ्गसङ्गिनौ ।"
      },
      {
        "line": 53,
        "text": "रक्षणाय मम रामलक्ष्मणावग्रतः पथि सदैव गच्छताम ॥20॥"
      },
      {
        "line": 54,
        "text": "सन्नद्धः कवची खड्गी चापबाणधरो युवा ।"
      },
      {
        "line": 55,
        "text": "गच्छन् मनोरथान नश्च रामः पातु सलक्ष्मणः ॥21॥"
      },
      {
        "line": 56,
        "text": "रामो दाशरथी शूरो लक्ष्मणानुचरो बली ।"
      },
      {
        "line": 57,
        "text": "काकुत्स्थः पुरुषः पूर्णः कौसल्येयो रघूत्तमः ॥22॥"
      },
      {
        "line": 58,
        "text": "वेदान्तवेद्यो यज्ञेशः पुराणपुरुषोत्तमः ।"
      },
      {
        "line": 59,
        "text": "जानकीवल्लभः श्रीमानप्रमेयपराक्रमः ॥23॥"
      },
      {
        "line": 60,
        "text": "इत्येतानि जपन नित्यं मद्भक्तः श्रद्धयान्वितः ।"
      },
      {
        "line": 61,
        "text": "अश्वमेधाधिकं पुण्यं सम्प्राप्नोति न संशयः ॥24॥"
      },
      {
        "line": 62,
        "text": "रामं दुर्वादलश्यामं पद्माक्षं पीतवाससम ।"
      },
      {
        "line": 63,
        "text": "स्तुवन्ति नामभिर्दिव्यैर्न ते संसारिणो नरः ॥25॥"
      },
      {
        "line": 64,
        "text": "रामं लक्ष्मणपूर्वजं रघुवरं सीतापतिं सुन्दरं,"
      },
      {
        "line": 65,
        "text": "काकुत्स्थं करुणार्णवं गुणनिधिं विप्रप्रियं धार्मिकम ।"
      },
      {
        "line": 66,
        "text": "राजेन्द्रं सत्यसंधं दशरथतनयं श्यामलं शांतमूर्तिं,"
      },
      {
        "line": 67,
        "text": "वन्दे लोकाभिरामं रघुकुलतिलकं राघवं रावणारिम ॥26॥"
      },
      {
        "line": 68,
        "text": "रामाय रामभद्राय रामचंद्राय वेधसे ।"
      },
      {
        "line": 69,
        "text": "रघुनाथाय नाथाय सीतायाः पतये नमः ॥27॥"
      },
      {
        "line": 70,
        "text": "श्रीराम राम रघुनन्दनराम राम,"
      },
      {
        "line": 71,
        "text": "श्रीराम राम भरताग्रज राम राम ।"
      },
      {
        "line": 72,
        "text": "श्रीराम राम रणकर्कश राम राम,"
      },
      {
        "line": 73,
        "text": "श्रीराम राम शरणं भव राम राम ॥28॥"
      },
      {
        "line": 74,
        "text": "श्रीराम चन्द्रचरणौ मनसा स्मरामि,"
      },
      {
        "line": 75,
        "text": "श्रीराम चंद्रचरणौ वचसा गृणामि ।"
      },
      {
        "line": 76,
        "text": "श्रीराम चन्द्रचरणौ शिरसा नमामि,"
      },
      {
        "line": 77,
        "text": "श्रीराम चन्द्रचरणौ शरणं प्रपद्ये ॥29॥"
      },
      {
        "line": 78,
        "text": "माता रामो मत्पिता रामचंन्द्र: ।"
      },
      {
        "line": 79,
        "text": "स्वामी रामो मत्सखा रामचंद्र: ।"
      },
      {
        "line": 80,
        "text": "सर्वस्वं मे रामचन्द्रो दयालु ।"
      },
      {
        "line": 81,
        "text": "नान्यं जाने नैव जाने न जाने ॥"
      },
      {
        "line": 82,
        "text": "दक्षिणे लक्ष्मणो यस्य वामे च जनकात्मज ।"
      },
      {
        "line": 83,
        "text": "पुरतो मारुतिर्यस्य तं वन्दे रघुनन्दनम् ॥31॥"
      },
      {
        "line": 84,
        "text": "लोकाभिरामं रणरंगधीरं राजीवनेत्रं रघुवंशनाथं ।"
      },
      {
        "line": 85,
        "text": "कारुण्यरूपं करुणाकरं तं श्रीरामचन्द्रं शरणं प्रपद्ये ॥32॥"
      },
      {
        "line": 86,
        "text": "मनोजवं मारुततुल्यवेगं जितेन्द्रियं बुद्धिमतां वरिष्ठम ।"
      },
      {
        "line": 87,
        "text": "वातात्मजं वानरयूथमुख्यं श्रीराम दूतं शरणं प्रपद्ये ॥33॥"
      },
      {
        "line": 88,
        "text": "कूजन्तं रामरामेति मधुरं मधुराक्षरम ।"
      },
      {
        "line": 89,
        "text": "आरुह्य कविताशाखां वन्दे वाल्मीकिकोकिलम ॥34॥"
      },
      {
        "line": 90,
        "text": "आपदामपहर्तारं दातारं सर्वसम्पदाम् ।"
      },
      {
        "line": 91,
        "text": "लोकाभिरामं श्रीरामं भूयो भूयो नमाम्यहम् ॥35॥"
      },
      {
        "line": 92,
        "text": "भर्जनं भवबीजानामर्जनं सुखसम्पदाम् ।"
      },
      {
        "line": 93,
        "text": "तर्जनं यमदूतानां रामरामेति गर्जनम् ॥36॥"
      },
      {
        "line": 94,
        "text": "रामो राजमणिः सदा विजयते,"
      },
      {
        "line": 95,
        "text": "रामं रमेशं भजे रामेणाभिहता,"
      },
      {
        "line": 96,
        "text": "निशाचरचमू रामाय तस्मै नमः ।"
      },
      {
        "line": 97,
        "text": "रामान्नास्ति परायणं परतरं,"
      },
      {
        "line": 98,
        "text": "रामस्य दासोस्म्यहं रामे चित्तलयः,"
      },
      {
        "line": 99,
        "text": "सदा भवतु मे भो राम मामुद्धराः ॥37॥"
      },
      {
        "line": 100,
        "text": "राम रामेति रामेति रमे रामे मनोरमे ।"
      },
      {
        "line": 101,
        "text": "सहस्त्रनाम तत्तुल्यं रामनाम वरानने ॥38॥"
      }
    ]
  }
}