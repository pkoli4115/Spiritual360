{
"id": "hanuman_chalisa_en",
"name_en": "Hanuman Chalisa",
"language": "en",
"category": "stotram",
"addedDate": "2025-07-24",
"content": {
"verses": [
{ "line": 1, "text": "Shri Guru Charan Saroj Raj, Nij Man Mukur Sudhari" },
{ "line": 2, "text": "Barnaun Raghubar Bimal Jasu, Jo Dayaku Phal Chari" },
{ "line": 3, "text": "Buddhiheen Tanu Janike, Sumirau Pavan Kumar" },
{ "line": 4, "text": "Bal Buddhi Vidya Dehu Mohi, Harahu Kalesh Vikar" },
{ "line": 5, "text": "Jai Hanuman Gyan Gun Sagar" },
{ "line": 6, "text": "Jai Kapis Tihun Lok Ujagar" },
{ "line": 7, "text": "Ramdoot Atulit Bal Dhama" },
{ "line": 8, "text": "Anjani Putra Pavan Sut Nama" },
{ "line": 9, "text": "Mahabir Bikram Bajrangi" },
{ "line": 10, "text": "Kumati Nivar Sumati Ke Sangi" },
{ "line": 11, "text": "Kanchan Baran Biraj Subesa" },
{ "line": 12, "text": "Kanan Kundal Kunchit Kesa" },
{ "line": 13, "text": "Haath Bajra Aur Dhvaja Birajai" },
{ "line": 14, "text": "Kandhe Moonj Janeu Sajai" },
{ "line": 15, "text": "Shankar Suvan Kesari Nandan" },
{ "line": 16, "text": "Tej Pratap Maha Jag Vandan" },
{ "line": 17, "text": "Vidya Van Guni Ati Chatur" },
{ "line": 18, "text": "Ram Kaj Karibe Ko Atur" },
{ "line": 19, "text": "Prabhu Charitra Sunibe Ko Rasiya" },
{ "line": 20, "text": "Ram Lakhan Sita Man Basiya" },
{ "line": 21, "text": "Sukshma Roop Dhari Siyahi Dikhava" },
{ "line": 22, "text": "Vikat Roop Dhari Lank Jarava" },
{ "line": 23, "text": "Bheem Roop Dhari Asur Sanhare" },
{ "line": 24, "text": "Ramchandra Ke Kaj Sanvare" },
{ "line": 25, "text": "Laye Sanjeevan Lakhan Jiyaye" },
{ "line": 26, "text": "Shri Raghuvir Harashi Ur Laye" },
{ "line": 27, "text": "Raghupati Kinhi Bahut Badai" },
{ "line": 28, "text": "Tum Mama Priya Bharat Sam Bhai" },
{ "line": 29, "text": "Sahas Badan Tumharo Jas Gave" },
{ "line": 30, "text": "As Kahi Shripati Kanth Lagave" },
{ "line": 31, "text": "Sankadik Brahmadi Muneesa" },
{ "line": 32, "text": "Narad Sarad Sahit Aheesa" },
{ "line": 33, "text": "Yam Kubera Digpal Jahan Te" },
{ "line": 34, "text": "Kavi Kovind Kahin Sake Kahan Te" },
{ "line": 35, "text": "Tum Upkar Sugrivahi Kina" },
{ "line": 36, "text": "Ram Milai Rajpad Deenha" },
{ "line": 37, "text": "Tumharo Mantra Vibhishan Mana" },
{ "line": 38, "text": "Lankeshwar Bhaye Sab Jag Jana" },
{ "line": 39, "text": "Yug Sahastra Jojan Par Bhanu" },
{ "line": 40, "text": "Lilyo Tahim Madhur Phal Janu" },
{ "line": 41, "text": "Prabhu Mudrika Meli Mukha Mahee" },
{ "line": 42, "text": "Jaladhi Langhi Gaye Achraj Nahi" },
{ "line": 43, "text": "Durgam Kaj Jagat Ke Jete" },
{ "line": 44, "text": "Sugam Anugrah Tumhre Tete" },
{ "line": 45, "text": "Ram Duare Tum Rakhware" },
{ "line": 46, "text": "Hot Na Agya Bin Paisare" },
{ "line": 47, "text": "Sab Sukh Lahen Tumhari Sarna" },
{ "line": 48, "text": "Tum Rakshak Kahu Ko Darna" },
{ "line": 49, "text": "Aapan Tej Samharo Aape" },
{ "line": 50, "text": "Teenon Lok Haink Te Kanpe" },
{ "line": 51, "text": "Bhoot Pishach Nikat Nahin Aave" },
{ "line": 52, "text": "Mahabir Jab Naam Sunave" },
{ "line": 53, "text": "Nase Rog Hare Sab Peera" },
{ "line": 54, "text": "Japat Nirantar Hanumat Beera" },
{ "line": 55, "text": "Sankat Se Hanuman Chudave" },
{ "line": 56, "text": "Man Kram Bachan Dhyan Jo Lave" },
{ "line": 57, "text": "Sab Par Ram Tapasvee Raja" },
{ "line": 58, "text": "Tin Ke Kaj Sakal Tum Saja" },
{ "line": 59, "text": "Aur Manorath Jo Koi Lave" },
{ "line": 60, "text": "Soi Amit Jeevan Phal Pave" },
{ "line": 61, "text": "Charon Yug Paratap Tumhara" },
{ "line": 62, "text": "Hai Prasiddha Jagat Ujiyara" },
{ "line": 63, "text": "Sadhu Sant Ke Tum Rakhware" },
{ "line": 64, "text": "Asur Nikandan Ram Dulare" },
{ "line": 65, "text": "Ashta Siddhi Nav Nidhi Ke Data" },
{ "line": 66, "text": "As Bar Din Janki Mata" },
{ "line": 67, "text": "Ram Rasayan Tumhare Pasa" },
{ "line": 68, "text": "Sada Raho Raghupati Ke Dasa" },
{ "line": 69, "text": "Tumhari Bhakti Ram Ko Pave" },
{ "line": 70, "text": "Janam Janam Ke Dukh Bisrave" },
{ "line": 71, "text": "Ant Kaal Raghuvar Pur Jai" },
{ "line": 72, "text": "Jahan Janm Hari Bhakt Kahai" },
{ "line": 73, "text": "Aur Devta Chit Na Dharai" },
{ "line": 74, "text": "Hanumat Sehi Sarb Sukh Karai" },
{ "line": 75, "text": "Sankat Kate Mite Sab Peera" },
{ "line": 76, "text": "Jo Sumirai Hanumat Balbeera" },
{ "line": 77, "text": "Jai Jai Jai Hanuman Gosai" },
{ "line": 78, "text": "Kripa Karahu Gurudev Ki Nai" },
{ "line": 79, "text": "Jo Sat Bar Path Kar Koi" },
{ "line": 80, "text": "Chhutahi Bandi Maha Sukh Hoi" },
{ "line": 81, "text": "Jo Yah Padhe Hanuman Chalisa" },
{ "line": 82, "text": "Hoye Siddhi Sakhi Gaurisa" },
{ "line": 83, "text": "Tulsidas Sada Hari Chera" },
{ "line": 84, "text": "Keeje Nath Hriday Mah Dera" },
{ "line": 85, "text": "Pavan Tanay Sankat Haran, Mangal Moorti Roop" },
{ "line": 86, "text": "Ram Lakhan Sita Sahit, Hriday Basahu Sur Bhoop" }
]
}
}
