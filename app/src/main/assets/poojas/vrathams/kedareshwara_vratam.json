        "bhuta_ucchatanam": "భూత పిశాచ నిశ్శేషణార్థం భూతోచ్ఛాటన శ్లోకం",
        "pranayama": "ఓం భూః భువః సువః...తో ప్రారంభమయ్యే ప్రాణాయామ శ్లోకాలు"
      },
      "sankalpam": {
        "structure": [
          "దేశకాల వివరాలు (నామ సంవత్సరం, ఋతువు, మాసం, పక్షం, తిథి, నక్షత్రం, యోగం, కరణం)",
          "యజమానుని పేరు, గోత్రం, కుటుంబ సంకల్పం",
          "పూజ లక్ష్యం (ఆయురారోగ్య ఐశ్వర్యార్థం, కష్టనివారణార్థం, పుత్రపౌత్రార్థం)"
        ]
      },
      "kalasha_puja": {
        "components": [
          "కలశ ముఖంలో విష్ణువు, కంఠంలో రుద్రుడు, మూలంలో బ్రహ్మ",
          "సప్త సముద్రాలు, నదీ జలాలు కలశంలో ఆహ్వానించాలి",
          "గంగ, యమున, గోదావరి, సరస్వతి, నర్మద, సింధు, కావేరి"
        ]
      },
      "shodashopachara_puja": {
        "steps": [
          "ఆవాహన, పాద్యం, అర్ఘ్యం, ఆచమనీయం",
          "మధుపర్కం, స్నానం, శుద్ధ జల స్నానం",
          "వస్త్రం, తిలకం, యజ్ఞోపవీతం, గంధం",
          "అలంకారాలు, పుష్పాలు, ధూపం, దీపం",
          "నైవేద్యం, తాంబూలం, కర్పూర నీరాజనం, మంత్రపుష్పం, నమస్కారం"
        ],
        "ganapati_ashtottara_namavali": 16,
        "upacharas": [
          "శక్త్యోపచారాలు",
          "రాజ్యోపచారాలు",
          "భక్త్యోపచారాలు"
        ]
      },
      "main_puja": {
        "deity": "శ్రీ కేదారేశ్వర స్వామి",
        "steps": [
          "ధ్యానం, ఆవాహనం, ఆసనం, పాద్యం",
          "అర్ఘ్యం, ఆచమనీయం, పంచామృత స్నానం",
          "వస్త్రం, యజ్ఞోపవీతం, గంధం, అక్షతాలు",
          "పుష్పం, అంగపూజ (శిరస్సు నుండి పాదములు వరకు)",
          "అష్టోత్తర శతనామావళి",
          "గ్రంథి పూజ (21 శివ నామాలు)",
          "ధూపం, దీపం, నైవేద్యం, తాంబూలం, నీరాజనం",
          "మంత్రపుష్పం, ప్రదక్షిణం, నమస్కారం"
        ]
      },
      "special_notes": {
        "vratha_katha": "పార్వతీదేవి, గౌతమ మహర్షి, వైశ్యుడు మరియు అతని కుమార్తెలు 'పుణ్యవతి' మరియు 'భాగ్యవతి' కథ",
        "outcome": "ఈ వ్రతం వల్ల పార్వతీ శివుని అర్ధాంగిని అయింది. వ్రతం వల్ల అనేకులకు శివానుగ్రహం లభించింది.",
        "upacharas": [
          "ఛత్రం",
          "చామరం",
          "నృత్యం",
          "గీతం",
          "ఆందోళిక",
          "రాజోపచారాలు"
        ]
      },
      "ending": {
        "kshema_ashirvachanam": "శాంతి మంత్రాలు, తీర్థ ప్రాశనం, వ్రత సఫలత కోసం ప్రార్థనలు",
        "haarati": "శివ మంగళ హారతి",
        "vratha_phala": "శివసాన్నిధ్యం, పాప విమోచనం, శుభఫలాలు"
