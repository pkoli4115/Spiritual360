        "fasting": "ఉపవాసం చేయాలి",
        "benefits": [
          "అష్టైశ్వర్యం",
          "అన్నవస్తు సమృద్ధి",
          "పుణ్యఫలాలు",
          "శివసాన్నిధ్యం"
        ]
      },
